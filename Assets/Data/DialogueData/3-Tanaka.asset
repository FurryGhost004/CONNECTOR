  lines:
  - charaterName: Tanaka
    charaterPortrait: {fileID: -1859725385913054086, guid: 62ccbfcfa36031741ab0166240c7c00a, type: 3}
    content: '"So he wants some wiring to fix their power station."'
  - charaterName: Tanaka
    charaterPortrait: {fileID: -1859725385913054086, guid: 62ccbfcfa36031741ab0166240c7c00a, type: 3}
    content: '"We can make it, but we''re short on materials." '
  - charaterName: Tanaka
    charaterPortrait: {fileID: -1859725385913054086, guid: 62ccbfcfa36031741ab0166240c7c00a, type: 3}
    content: '"Take this list and gather everything on it for us." '
