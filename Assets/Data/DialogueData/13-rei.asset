  lines:
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"The passcode open their command center?!"'
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"With it destroy! The robots cannot retreat now"'
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"The AI is trying to fix the command center"'
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"I should return to the port and turn on all the station to make it
      overload, and stall more time before it can fix the center"'
