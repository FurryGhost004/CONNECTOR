MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3db5d0f3ae819ee448ada59abd31955d, type: 3}
  m_Name: 1-Momoko
  m_EditorClassIdentifier: Assembly-CSharp::DialougeeData
  lines:
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"Oh! you are the one we rescue right?"'
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"What bring you here?"'
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"I bring you the casualty report, i sorry... and thank you"'
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"... I see!  "'
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"Don''t grieve for us. They knew what they were walking into. We went
      into enemy territory blind. It was practically a suicide mission."'
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"To be honest, we didn''t even know if it would succeed."'
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"Since you are here, bring us some supplies. Cigarettes, if you can.
      Morale is running low."'
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"Got it."'
