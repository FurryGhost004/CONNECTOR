--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3db5d0f3ae819ee448ada59abd31955d, type: 3}
  m_Name: 4-Yamada
  m_EditorClassIdentifier: Assembly-CSharp::DialougeeData
  lines:
  - charaterName: Yamada
    charaterPortrait: {fileID: -2731085992964166111, guid: cdf1f461060dd0644be62deaac078797, type: 3}
    content: '"Now that you''ve brought the wiring, we''ll look for a chance to fix
      the power station in the next few days."'
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"Why don''t you do it now?"'
  - charaterName: Yamada
    charaterPortrait: {fileID: -2731085992964166111, guid: cdf1f461060dd0644be62deaac078797, type: 3}
    content: '"Well, we still have to smuggle out at least a pair of rubber gloves.
      It usually takes a week to do that."'
  - charaterName: Yamada
    charaterPortrait: {fileID: -2731085992964166111, guid: cdf1f461060dd0644be62deaac078797, type: 3}
    content: '"But you delivered faster than any courier we''ve had before. So now
      we can''t do anything but wait."'
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"If you want, I can do it for you. I have my suit and I know how to
      fix those stations."'
  - charaterName: Yamada
    charaterPortrait: {fileID: -2731085992964166111, guid: cdf1f461060dd0644be62deaac078797, type: 3}
    content: '"Really? Please do! Thank you so much. With you, we might actually
      win this time."'
