  lines:
  - charaterName: Takeda
    charaterPortrait: {fileID: 21300000, guid: 43af21ed129bb4f41872e52757709ecd, type: 3}
    content: "\u201COh, you\u2019re awake. How are you feeling?\u201D"
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: "\u201CUh! Where i'm i?\u201D"
  - charaterName: Takeda
    charaterPortrait: {fileID: 21300000, guid: 43af21ed129bb4f41872e52757709ecd, type: 3}
    content: "\u201CThis place\u2026 it\u2019s the Rebel hideout, deep in the Dump.\u201D"
  - charaterName: Takeda
    charaterPortrait: {fileID: 21300000, guid: 43af21ed129bb4f41872e52757709ecd, type: 3}
    content: "\u201CYou have been fainting for hours since we rescue you from the
      prison\u201D"
  - charaterName: Takeda
    charaterPortrait: {fileID: 21300000, guid: 43af21ed129bb4f41872e52757709ecd, type: 3}
    content: "\u201CEasy now. Try moving your legs first. First, come over here.
      \u201D"
