  m_Script: {fileID: 11500000, guid: 3db5d0f3ae819ee448ada59abd31955d, type: 3}
  m_Name: 7-Crow
  m_EditorClassIdentifier: Assembly-CSharp::DialougeeData
  lines:
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"Now it''s a crow? Has the situation become so tense that we have to
      communicate through animals?"'
  - charaterName: Tanaka
    charaterPortrait: {fileID: 4324600005252606433, guid: a43c4469be4e3a74494ed13c0654f203, type: 3}
    content: '"Sorry I couldn''t meet you in person. The number of robots here keeps
      increasing. I don''t think it''s safe for me to move around alone."'
  - charaterName: Tanaka
    charaterPortrait: {fileID: 4324600005252606433, guid: a43c4469be4e3a74494ed13c0654f203, type: 3}
    content: '"By the way, bring the wiring to the port and fix the stations there."'
