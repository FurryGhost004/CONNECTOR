--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3db5d0f3ae819ee448ada59abd31955d, type: 3}
  m_Name: 5-Momoko
  m_EditorClassIdentifier: Assembly-CSharp::DialougeeData
  lines:
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"Thank for fix the station"'
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"What is it for?"'
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"Many things. But the most important one is to lure those robots out."'
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"It will clear a path for you to reach the main computer."'
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"How?"'
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"We plan to build more of these, to make it look like we''re trying
      to isolate ourselves from the AI."'
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"Since we''ve only fixed one so far, the next time you come back, there
      will be more robots tracking us to see what we''re planning to do with it."'
  - charaterName: Kageyama Rei
    charaterPortrait: {fileID: 5954461964394930157, guid: f79b7f0c3d0104b45812246df264f385, type: 3}
    content: '"I see. The moment you fix more of these and start fighting back, it
      will send its army here."'
  - charaterName: Momoko
    charaterPortrait: {fileID: -5549688341650823952, guid: 3b1ef82ee684c5b4494115da0635f06e, type: 3}
    content: '"Yes, we need you to deliver this report letter to Kohaku, he lives
      in the Tsukishiro Port "'
